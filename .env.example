# Шаблон локальных секретов деплоя. Реальный файл .env создаётся АВТОМАТИЧЕСКИ при
# первом запуске deploy.bat (генерируется случайный APP_JWT_SECRET) и НЕ коммитится
# в git (см. .gitignore) — раньше эти значения были прямо захардкожены в
# docker-compose.yml и утекали в историю репозитория, теперь так делать нельзя
# (см. аудит безопасности: секрет из git позволял подделать JWT администратора).
#
# Скопируйте этот файл в .env и подставьте свои значения, если хотите задать их
# вручную (например, для переноса на новый сервер) — иначе просто запустите
# deploy.bat, он создаст .env сам.

# Секрет подписи JWT-токенов — строка любой длины (чем длиннее, тем лучше,
# рекомендуется 64+ случайных hex-символов). Смена значения мгновенно делает
# недействительными все ранее выданные токены — пользователям придётся
# перелогиниться, это ожидаемо и безопасно.
APP_JWT_SECRET=замените-на-случайную-строку

# Пароль пользователя БД adminpanel в контейнере postgres.
# ВНИМАНИЕ: Postgres применяет этот пароль только при первой инициализации ПУСТОГО
# тома pgdata. Если у вас уже есть развёрнутый стенд с паролем по умолчанию
# ("adminpanel") — простая смена этой переменной сломает подключение backend к БД
# (пароль в контейнере останется старым). Чтобы сменить пароль на уже работающем
# стенде без потери данных:
#   1. docker compose exec postgres psql -U adminpanel -d adminpanel
#      -c "ALTER USER adminpanel WITH PASSWORD 'новый-пароль';"
#   2. Указать тот же "новый-пароль" здесь, в POSTGRES_PASSWORD.
#   3. docker compose up -d (пересоздаст backend с новым паролем в переменных окружения).
# Либо, если готовы потерять данные БД — docker compose down -v и просто задать
# новый пароль здесь до первого запуска.
POSTGRES_PASSWORD=adminpanel
